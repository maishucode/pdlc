    { "stageId": "success-measures", "inclusion": "required" },
    { "stageId": "scope-definition", "inclusion": "required" },
    { "stageId": "requirements-clarification", "inclusion": "required" },
    { "stageId": "requirements-analysis", "inclusion": "required" },
    { "stageId": "acceptance-criteria-definition", "inclusion": "required" },
    { "stageId": "data-integration-boundaries", "inclusion": "required" },
    { "stageId": "risk-classification", "inclusion": "required" },
    { "stageId": "principle-applicability", "inclusion": "required" },
    { "stageId": "requirements-approval", "inclusion": "required" },
    { "stageId": "solution-design", "inclusion": "required" },
    { "stageId": "ux-design", "inclusion": "conditional", "activationTags": ["technology:web-ui", "technology:mobile-ui"] },
    { "stageId": "test-strategy", "inclusion": "required" },
