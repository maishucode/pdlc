{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/domain.schema.json",
  "title": "Domain Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "owners",
    "policyApprovers",
    "maintainers",
    "contributionMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "policyApprovers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "contributionMode": {
      "type": "object",
      "required": ["artifacts", "controls", "knowledge", "capabilities"],
      "properties": {
        "artifacts": { "enum": ["restricted", "reviewed", "open"] },
        "controls": { "enum": ["restricted", "reviewed", "open"] },
        "knowledge": { "enum": ["restricted", "reviewed", "open"] },
        "capabilities": { "enum": ["restricted", "reviewed", "open"] }
      },
      "additionalProperties": false
    },
    "defaultApplicability": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
