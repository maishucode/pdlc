{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/principle-pack.schema.json",
  "title": "PDLC Principle Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "owner", "version", "appliesTo", "enforcement", "principles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflows", "stages"],
      "properties": {
        "workflows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["poc", "implementation", "pdlc"] } },
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "riskTriggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "technologies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "domains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poc", "implementation", "pdlc"],
      "properties": {
        "poc": { "$ref": "#/$defs/enforcement" },
        "implementation": { "$ref": "#/$defs/enforcement" },
        "pdlc": { "$ref": "#/$defs/enforcement" }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "standardDefault": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "topic", "policy"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
              "topic": { "enum": ["productContext", "functionalBehavior", "userScenarios", "uxInteraction", "qualityAttributes", "dataIntegrations", "scopeSuccess"] },
              "policy": { "enum": ["constraint", "default"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "enforcement": { "enum": ["required", "risk-based", "advisory", "not-applicable"] }
  }
}
