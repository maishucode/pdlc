{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/workflow.schema.json",
  "title": "PDLC Executable Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "journeyId", "initialStatus", "terminalStatuses", "checkpoints", "deliveryDefaults", "constraints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["poc", "implementation", "pdlc"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "journeyId": { "enum": ["poc", "implementation", "pdlc"] },
    "initialStatus": { "type": "string", "minLength": 1 },
    "terminalStatuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "ownerRole"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "to": { "type": "string", "minLength": 1 },
          "toByOutcome": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
          "ownerRole": { "enum": ["product", "developer", "qa"] }
        },
        "oneOf": [
          { "required": ["to"], "not": { "required": ["toByOutcome"] } },
          { "required": ["toByOutcome"], "not": { "required": ["to"] } }
        ]
      }
    },
    "deliveryDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleAssignmentMode", "timebox", "collectDuringRequirements"],
      "properties": {
        "roleAssignmentMode": { "const": "approval-actor-all-roles" },
        "timebox": { "type": "string", "minLength": 1 },
        "collectDuringRequirements": { "const": false }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionUse", "externalIntegrations", "allowSinglePersonAllRoles"],
      "properties": {
        "productionUse": { "type": "boolean" },
        "externalIntegrations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowSinglePersonAllRoles": { "type": "boolean" }
      }
    }
  }
}
