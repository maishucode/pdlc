{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/standard-profile.schema.json",
  "title": "PDLC Standard Default Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "owner", "version", "layer", "appliesTo", "defaults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "layer": { "enum": ["harness", "project"] },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflows", "stages"],
      "properties": {
        "workflows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["poc", "implementation", "pdlc"] } },
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "technologies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "domains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "topic", "statement", "rationale", "principleRefs"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "topic": { "enum": ["productContext", "functionalBehavior", "userScenarios", "uxInteraction", "qualityAttributes", "dataIntegrations", "scopeSuccess"] },
          "statement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "principleRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
