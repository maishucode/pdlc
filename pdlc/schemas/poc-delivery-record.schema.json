{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/poc-delivery-record.schema.json",
  "title": "POC Delivery Record v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "deliveryFlow",
    "status",
    "title",
    "revision",
    "createdAt",
    "updatedAt",
    "assignments",
    "idea",
    "requirements",
    "scope",
    "risk",
    "resolution",
    "design",
    "evidence",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "deliveryFlow": {
      "const": "poc"
    },
    "status": {
      "enum": [
        "DRAFT",
        "COMMITTED",
        "VERIFIED",
        "CLOSED_KILLED",
        "CLOSED_PIVOTED",
        "CLOSED_PRODUCTIZED"
      ]
    },
    "title": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assignments": {
      "type": "object"
    },
    "idea": {
      "type": "object"
    },
    "requirements": {
      "type": "object",
      "required": [
        "artifactType",
        "documentRef",
        "profile",
        "status",
        "clarification",
        "approvedBy",
        "approvedAt",
        "approvedContentHash"
      ]
    },
    "scope": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "resolution": {
      "type": "object",
      "required": [
        "controls",
        "baselines",
        "defaults",
        "knowledge",
        "capabilities"
      ]
    },
    "design": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
