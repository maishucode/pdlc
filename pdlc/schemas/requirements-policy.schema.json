{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/requirements-policy.schema.json",
  "title": "PDLC Requirements Clarification Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "owner", "version", "depths", "questionRules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "depths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimal", "standard", "comprehensive"],
      "properties": {
        "minimal": { "$ref": "#/$defs/depth" },
        "standard": { "$ref": "#/$defs/depth" },
        "comprehensive": { "$ref": "#/$defs/depth" }
      }
    },
    "questionRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxQuestionsPerRound", "requireOtherOption", "analyzeContradictions", "requireFinalDocumentReview", "allowDocumentAnswers", "questionDocumentPattern", "answerTag"],
      "properties": {
        "maxQuestionsPerRound": { "type": "integer", "minimum": 1, "maximum": 3 },
        "requireOtherOption": { "type": "boolean" },
        "analyzeContradictions": { "type": "boolean" },
        "requireFinalDocumentReview": { "type": "boolean" },
        "allowDocumentAnswers": { "const": true },
        "questionDocumentPattern": { "type": "string", "pattern": "^\\.pdlc/questions/\\{recordId\\}[-a-z0-9{}]*\\.md$" },
        "answerTag": { "const": "[Answer]:" }
      }
    }
  },
  "$defs": {
    "topic": {
      "enum": ["productContext", "functionalBehavior", "userScenarios", "uxInteraction", "qualityAttributes", "dataIntegrations", "scopeSuccess"]
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAnsweredQuestions", "requiredTopics"],
      "properties": {
        "minimumAnsweredQuestions": { "type": "integer", "minimum": 1 },
        "requiredTopics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/topic" } }
      }
    }
  }
}
