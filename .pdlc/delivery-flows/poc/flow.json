{
  "schemaVersion": 2,
  "id": "poc",
  "name": "POC Delivery Flow",
  "description": "A bounded, non-production Delivery Flow that tests an idea and produces a park or recommend-productization decision.",
  "status": "active",
  "runtime": {
    "executor": "executor.ts",
    "recordSchema": "schemas/poc-delivery-record.schema.json",
    "actions": ["build-readiness"]
  },
  "stageSequence": [
    { "stageId": "requirements-clarification", "inclusion": "required" },
    { "stageId": "solution-design", "inclusion": "required" },
    { "stageId": "ux-design", "inclusion": "conditional", "activationTags": ["technology:web-ui", "technology:mobile-ui"] },
    { "stageId": "build-readiness", "inclusion": "required" },
    { "stageId": "requirements-approval", "inclusion": "required" },
    { "stageId": "implementation", "inclusion": "required" },
    { "stageId": "developer-verification", "inclusion": "required" },
    { "stageId": "security-verification", "inclusion": "conditional", "activationTags": ["risk:sensitive-data", "risk:external-access", "risk:credentials", "risk:regulated-data"] },
    { "stageId": "acceptance-verification", "inclusion": "required" },
    { "stageId": "outcome-review-and-disposition", "inclusion": "required" }
  ],
  "controls": {
    "initialStatus": "DRAFT",
    "terminalStatuses": [
      "PARKED",
      "PRODUCTIZATION_RECOMMENDED"
    ],
    "checkpoints": [
      {
        "id": "commit",
        "from": ["DRAFT", "COMMITTED"],
        "to": "COMMITTED",
        "ownerRole": "product"
      },
      {
        "id": "verify",
        "from": ["COMMITTED"],
        "to": "VERIFIED",
        "ownerRole": "qa"
      },
      {
        "id": "decide",
        "from": ["VERIFIED"],
        "toByOutcome": {
          "park": "PARKED",
          "recommend-productization": "PRODUCTIZATION_RECOMMENDED"
        },
        "ownerRole": "product"
      }
    ],
    "deliveryDefaults": {
      "roleAssignmentMode": "approval-actor-all-roles",
      "timebox": "1 working day",
      "collectDuringRequirements": false,
      "requirementsProfile": "standard"
    },
    "constraints": {
      "productionUse": false,
      "externalIntegrations": [],
      "allowSinglePersonAllRoles": true
    }
  }
}
