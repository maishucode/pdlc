{
  "schemaVersion": 2,
  "id": "poc",
  "name": "POC Delivery Flow",
  "description": "A bounded, non-production Delivery Flow that tests an idea and produces a kill, pivot, or productize decision.",
  "status": "active",
  "stageSequence": [
    { "stageId": "ideation-intake", "inclusion": "required" },
    { "stageId": "problem-framing", "inclusion": "required" },
    { "stageId": "hypothesis-definition", "inclusion": "required" },
    { "stageId": "success-measures", "inclusion": "required" },
    { "stageId": "scope-definition", "inclusion": "required" },
    { "stageId": "requirements-clarification", "inclusion": "required" },
    { "stageId": "requirements-analysis", "inclusion": "required" },
    { "stageId": "acceptance-criteria-definition", "inclusion": "required" },
    { "stageId": "data-integration-boundaries", "inclusion": "required" },
    { "stageId": "risk-classification", "inclusion": "required" },
    { "stageId": "requirements-approval", "inclusion": "required" },
    { "stageId": "solution-design", "inclusion": "required" },
    { "stageId": "ux-design", "inclusion": "conditional", "activationTags": ["technology:web-ui", "technology:mobile-ui"] },
    { "stageId": "test-strategy", "inclusion": "required" },
    { "stageId": "build-readiness", "inclusion": "required" },
    { "stageId": "implementation", "inclusion": "required" },
    { "stageId": "developer-verification", "inclusion": "required" },
    { "stageId": "security-verification", "inclusion": "conditional", "activationTags": ["risk:sensitive-data", "risk:external-access", "risk:credentials", "risk:regulated-data"] },
    { "stageId": "test-execution", "inclusion": "required" },
    { "stageId": "acceptance-verification", "inclusion": "required" },
    { "stageId": "outcome-review-and-disposition", "inclusion": "required" }
  ],
  "controls": {
    "initialStatus": "DRAFT",
    "terminalStatuses": [
      "CLOSED_KILLED",
      "CLOSED_PIVOTED",
      "CLOSED_PRODUCTIZED"
    ],
    "checkpoints": [
      {
        "id": "commit",
        "from": ["DRAFT"],
        "to": "COMMITTED",
        "ownerRole": "product"
      },
      {
        "id": "verify",
        "from": ["COMMITTED"],
        "to": "VERIFIED",
        "ownerRole": "qa"
      },
      {
        "id": "decide",
        "from": ["VERIFIED"],
        "toByOutcome": {
          "kill": "CLOSED_KILLED",
          "pivot": "CLOSED_PIVOTED",
          "productize": "CLOSED_PRODUCTIZED"
        },
        "ownerRole": "product"
      }
    ],
    "deliveryDefaults": {
      "roleAssignmentMode": "approval-actor-all-roles",
      "timebox": "1 working day",
      "collectDuringRequirements": false
    },
    "constraints": {
      "productionUse": false,
      "externalIntegrations": [],
      "allowSinglePersonAllRoles": true
    },
    "artifactProfiles": {
      "product-management.requirements": "minimal"
    }
  }
}
