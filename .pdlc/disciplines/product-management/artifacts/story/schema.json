{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/artifacts/product-management.story.schema.json",
  "title": "Delivery Story",
  "type": "object",
  "required": ["artifactType", "title", "requirementRefs", "acceptanceCriteria"],
  "properties": {
    "artifactType": { "const": "product-management.story" },
    "title": { "type": "string", "minLength": 1 },
    "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
