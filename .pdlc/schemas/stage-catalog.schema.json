{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/stage-catalog.schema.json",
  "title": "Canonical Stage Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "owner",
    "stages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "catalogVersion": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "phase",
          "roleSlots",
          "requirements",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "discover",
              "define",
              "design",
              "build",
              "verify",
              "release",
              "outcome"
            ]
          },
          "roleSlots": {
            "type": "array",
            "items": {
              "enum": [
                "product",
                "developer",
                "qa"
              ]
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
