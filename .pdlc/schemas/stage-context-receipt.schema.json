{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/stage-context-receipt.schema.json",
  "title": "Stage Context Receipt",
  "type": "object",
  "required": ["schemaVersion", "stage", "contextHash", "policies", "knowledge", "domainContributions", "integrations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "stage": { "type": "string", "minLength": 1 },
    "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "knowledge": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "domainContributions": { "type": "array", "items": { "$ref": "#/$defs/domainContribution" } },
    "integrations": { "type": "array", "items": { "$ref": "#/$defs/integration" } }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "required": ["ref", "notes"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assetFields": {
      "type": "object",
      "required": ["ref", "disposition", "notes", "evidenceRefs"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["used", "not-used"] },
        "notes": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "asset": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "domainContribution": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "type": "object",
          "required": ["capability", "agent", "skills", "execution"],
          "properties": {
            "capability": { "type": "string", "minLength": 1 },
            "agent": { "type": "string", "minLength": 1 },
            "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "execution": {
              "type": "object",
              "required": ["invocationId", "platform", "status", "platformExecutionRef", "permissions"],
              "properties": {
                "invocationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "platform": { "const": "github-copilot" },
                "status": { "const": "completed" },
                "platformExecutionRef": { "type": "string", "pattern": "^github-copilot:agent:[a-z0-9-]+:[a-f0-9]{64}:[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                "permissions": {
                  "type": "object",
                  "required": ["filesystem", "network", "externalWrites"],
                  "properties": {
                    "filesystem": { "enum": ["read", "write"] },
                    "network": { "type": "boolean" },
                    "externalWrites": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "properties": { "disposition": { "const": "used" } }
        },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "integration": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "type": "object",
          "required": ["skills"],
          "properties": {
            "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false
}
