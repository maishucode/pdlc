{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/stage-context-receipt.schema.json",
  "title": "Stage Context Receipt",
  "type": "object",
  "required": ["schemaVersion", "stage", "contextHash", "policies", "knowledge", "disciplineContributions", "integrations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "stage": { "type": "string", "minLength": 1 },
    "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "knowledge": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "disciplineContributions": { "type": "array", "items": { "$ref": "#/$defs/disciplineContribution" } },
    "integrations": { "type": "array", "items": { "$ref": "#/$defs/integration" } },
    "stageInvocation": { "$ref": "#/$defs/stageInvocation" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "required": ["ref", "notes"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assetFields": {
      "type": "object",
      "required": ["ref", "disposition", "notes", "evidenceRefs"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["used", "not-used"] },
        "notes": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "asset": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "disciplineContribution": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "type": "object",
          "required": ["capability", "agent", "selectedSkills"],
          "properties": {
            "capability": { "type": "string", "minLength": 1 },
            "agent": { "type": "string", "minLength": 1 },
            "selectedSkills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        {
          "properties": { "disposition": { "const": "used" } }
        },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "stageInvocation": {
      "type": "object",
      "required": ["invocationId", "platform", "executor", "agentType", "status", "platformExecutionRef", "permissions"],
      "properties": {
        "invocationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "platform": { "const": "github-copilot" },
        "executor": { "const": "generic-subagent" },
        "agentType": { "const": "general-purpose" },
        "status": { "const": "completed" },
        "platformExecutionRef": { "type": "string", "pattern": "^github-copilot:subagent:\\S+$" },
        "permissions": {
          "type": "object",
          "required": ["filesystem", "network", "externalWrites"],
          "properties": {
            "filesystem": { "enum": ["read", "write"] },
            "network": { "type": "boolean" },
            "externalWrites": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "integration": {
      "allOf": [
        { "$ref": "#/$defs/assetFields" },
        {
          "type": "object",
          "required": ["skills"],
          "properties": {
            "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "used" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "disciplineContributions": { "minItems": 1 } } },
      "then": { "required": ["stageInvocation"] },
      "else": { "not": { "required": ["stageInvocation"] } }
    }
  ],
  "additionalProperties": false
}
