{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/delivery-flow-catalog.schema.json",
  "title": "Delivery Flow Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "owner",
    "flows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
