{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/artifact-definition.schema.json",
  "title": "Artifact Definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "ownerDiscipline",
    "version",
    "format",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "ownerDiscipline": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "format": {
      "enum": [
        "markdown",
        "json",
        "reference"
      ]
    },
    "schemaRef": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "defaultTemplate": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
