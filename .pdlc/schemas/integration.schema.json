{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/integration.schema.json",
  "title": "Integration Manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "version", "description", "owners", "maintainers", "appliesTo", "skills", "permissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "integration" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "maintainers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "appliesTo": { "type": "object" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object",
      "required": ["network", "credentialRefs", "externalWrites"],
      "properties": {
        "network": { "type": "boolean" },
        "credentialRefs": { "type": "array", "items": { "type": "string" } },
        "externalWrites": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
