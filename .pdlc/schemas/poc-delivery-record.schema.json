{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/poc-delivery-record.schema.json",
  "title": "POC Delivery Record v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "deliveryFlow",
    "status",
    "title",
    "revision",
    "createdAt",
    "updatedAt",
    "assignments",
    "source",
    "idea",
    "requirements",
    "scope",
    "risk",
    "resolution",
    "design",
    "evidence",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string"
    },
    "deliveryFlow": {
      "const": "poc"
    },
    "status": {
      "enum": [
        "DRAFT",
        "COMMITTED",
        "VERIFIED",
        "PARKED",
        "PRODUCTIZATION_RECOMMENDED"
      ]
    },
    "title": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assignments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": ["baseRevision", "derivedFromRecord", "deliveredRevision"],
      "properties": {
        "baseRevision": { "type": "string", "pattern": "^$|^[a-f0-9]{7,64}$" },
        "derivedFromRecord": { "type": "string" },
        "deliveredRevision": { "type": "string", "pattern": "^$|^[a-f0-9]{7,64}$" }
      },
      "additionalProperties": false
    },
    "idea": {
      "type": "object"
    },
    "requirements": {
      "type": "object",
      "required": [
        "artifactType",
        "documentRef",
        "profile",
        "status",
        "clarification",
        "approvedBy",
        "approvedAt",
        "approvedContentHash"
      ]
    },
    "scope": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "resolution": {
      "type": "object",
      "required": [
        "controls",
        "baselines",
        "defaults",
        "knowledge",
        "integrations",
        "contextApplications"
      ]
    },
    "design": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "required": ["outcome", "rationale", "followUp", "productizationPackage"],
      "properties": {
        "outcome": { "enum": ["", "park", "recommend-productization"] },
        "rationale": { "type": "string" },
        "followUp": { "type": "string" },
        "productizationPackage": {
          "type": "object",
          "required": ["artifactType", "documentRef", "contentHash"],
          "properties": {
            "artifactType": { "const": "product-management.productization-package" },
            "documentRef": { "type": "string" },
            "contentHash": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PARKED" } }, "required": ["status"] },
      "then": { "properties": { "decision": { "properties": { "outcome": { "const": "park" } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "PRODUCTIZATION_RECOMMENDED" } }, "required": ["status"] },
      "then": { "properties": { "decision": { "properties": { "outcome": { "const": "recommend-productization" } } } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["DRAFT", "COMMITTED", "VERIFIED"] } }, "required": ["status"] },
      "then": { "properties": { "decision": { "properties": { "outcome": { "const": "" } } } } }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "outcome": { "const": "recommend-productization" } },
            "required": ["outcome"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "productizationPackage": {
                "properties": {
                  "documentRef": { "type": "string", "minLength": 1, "pattern": "\\.md$" },
                  "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
