{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/control-policy.schema.json",
  "title": "Control Policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "ownerDiscipline",
    "version",
    "appliesTo",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "ownerDiscipline": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "appliesTo": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "enforcement", "enforceAt"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "enforcement": { "enum": ["automatic", "evidence", "approval"] },
          "enforceAt": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "requiredEvidence": { "type": "array", "items": { "type": "string" } },
          "exceptionApprovers": { "type": "array", "items": { "type": "string" } },
          "standardDefault": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
