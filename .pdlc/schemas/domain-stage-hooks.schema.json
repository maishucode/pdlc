{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pdlc/domain-stage-hooks.schema.json",
  "title": "Domain Stage Hooks",
  "type": "object",
  "required": ["schemaVersion", "domain", "version", "deliveryFlows", "enabled", "permissions", "bindings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "domain": { "type": "string" },
    "version": { "type": "string" },
    "deliveryFlows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "enabled": { "type": "boolean" },
    "permissions": {
      "type": "object",
      "required": ["filesystem", "network", "externalWrites"],
      "properties": {
        "filesystem": { "enum": ["read", "write"] },
        "network": { "type": "boolean" },
        "externalWrites": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "capability", "invocation", "agent", "skills", "mode", "handoff", "approvalBoundary"],
        "properties": {
          "stage": { "type": "string" },
          "capability": { "type": "string" },
          "invocation": { "const": "required" },
          "agent": { "type": "string" },
          "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "mode": { "enum": ["draft", "implement", "verify"] },
          "handoff": { "type": "string" },
          "approvalBoundary": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
