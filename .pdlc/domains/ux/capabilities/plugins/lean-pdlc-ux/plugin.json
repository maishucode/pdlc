{
  "schemaVersion": 2,
  "kind": "plugin",
  "id": "lean-pdlc-ux",
  "ownerDomain": "ux",
  "version": "0.3.0",
  "description": "Stage-aware UX design, React delivery, and verification contributions for Lean PDLC.",
  "deliveryFlows": ["poc"],
  "defaultEnabled": true,
  "permissions": {
    "filesystem": "write",
    "network": false,
    "externalWrites": false
  },
  "contributes": {
    "stageBindings": "pdlc-stage-bindings.json",
    "agents": "agents",
    "skills": "skills"
  }
}
